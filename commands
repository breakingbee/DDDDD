#!/system/bin/sh
# ============================================================================
# Démarre le daemon PANEL (busybox httpd) + AUTO-RÉPARATION de l'autorun.
# autorun.sh est un fichier sensible : un plugin USB tiers ou un client root peut
# l'écraser/l'éditer et faire disparaître la ligne qui lance le panel au boot.
# Parades :
#   1) à chaque démarrage on RÉINSÈRE la ligne panel dans autorun.sh si absente
#      (backup + sans doublon, insérée AVANT OrcaGold qui bloque) ;
#   2) un WATCHDOG détaché re-vérifie périodiquement (autorun + httpd vivant),
#      de sorte qu'une édition d'autorun est soignée AVANT le prochain reboot.
# Modes : (défaut) heal + httpd + watchdog ; « --tick » (watchdog) heal + httpd.
# Idempotent. Compatible Android 7 / busybox ash.
# ============================================================================
# PATH complet : quand le daemon est lance par le LAUNCHER (Home.onCreate), il
# herite d'un env minimal -> les CGI (getprop/dumpsys) sortent du JSON vide.
# On force un PATH systeme, herite par httpd et donc par les CGI.
export PATH=/system/bin:/system/xbin:/vendor/bin:/sbin:$PATH
DIR=/data/plugin/panel
AR=/data/plugin/autorun.sh
PANEL_LINE='[ -x /data/plugin/panel/start.sh ] && /system/bin/sh /data/plugin/panel/start.sh'
PORT=$(sed -n 's/^port=//p' "$DIR/panel.conf" 2>/dev/null); [ -z "$PORT" ] && PORT=8890

heal_autorun(){
  if [ ! -f "$AR" ]; then
    { printf '#!/system/bin/sh\n%s\n' "$PANEL_LINE"; } > "$AR"; chmod 755 "$AR"
    return 0
  fi
  grep -q 'panel/start.sh' "$AR" 2>/dev/null && return 0   # ligne déjà présente
  [ -f "$AR.bak_panelheal" ] || cp -f "$AR" "$AR.bak_panelheal" 2>/dev/null
  TMP="$AR.tmp.$$"; : > "$TMP"; INS=0
  while IFS= read -r l; do
    case "$l" in
      /data/plugin/OrcaGold*)   # ligne de commande OrcaGold (pas un commentaire)
        [ "$INS" = 0 ] && { printf '%s\n' "$PANEL_LINE" >> "$TMP"; INS=1; } ;;
    esac
    printf '%s\n' "$l" >> "$TMP"
  done < "$AR"
  [ "$INS" = 0 ] && printf '%s\n' "$PANEL_LINE" >> "$TMP"   # pas d'OrcaGold -> à la fin
  # remplacement atomique seulement si le TMP est cohérent (non vide)
  [ -s "$TMP" ] && cp -f "$TMP" "$AR" && chmod 755 "$AR"
  rm -f "$TMP"
}

am_root(){ [ "$(id -u 2>/dev/null)" = "0" ]; }

# pid du process qui ecoute :$PORT (busybox httpd), ou vide.
listener_pid(){
  # pid lie a :$PORT, SANS netstat -p : 'netstat -ltnp' scanne /proc/*/fd de
  # TOUS les process et declenche une fausse alerte "mem-injector" du
  # module-security (qui tue alors le process -> churn / restart f_server).
  # On resout le socket LISTEN via /proc/net/tcp{,6} (inode) puis le pid
  # proprietaire via /proc/*/fd (readlink de socket:[inode] uniquement,
  # jamais d'ouverture de /proc/*/mem -> invisible pour le module).
  _hp=$(busybox awk -v p="$PORT" 'BEGIN{printf "%04X", p}')
  _ino=$(busybox awk -v hp=":$_hp" '$4=="0A" && $2 ~ hp"$"{print $10; exit}' \
            /proc/net/tcp /proc/net/tcp6 2>/dev/null)
  [ -z "$_ino" ] && return
  for _d in /proc/[0-9]*; do
    for _fd in "$_d"/fd/*; do
      [ "$(busybox readlink "$_fd" 2>/dev/null)" = "socket:[$_ino]" ] && {
        echo "${_d#/proc/}"; return; }
    done 2>/dev/null
  done
}
# uid reel d'un pid via /proc (1er champ de la ligne Uid:), ou vide.
proc_uid(){
  busybox grep -m1 '^Uid:' "/proc/$1/status" 2>/dev/null \
    | sed -n 's/^Uid:[^0-9]*\([0-9][0-9]*\).*/\1/p'
}

# ROOT-TAKEOVER — le daemon DOIT tourner en root (sinon /data/plugin/panel/tmp
# 700-root non inscriptible -> download KO, et install.sh /system -> KO).
# f_server execute autorun.sh en ROOT a chaque boot : cette passe root reprend
# TOUJOURS la main, meme si le launcher (uid system) a binde :$PORT en premier.
#  - lance en root  : si le listener actuel n'est PAS root, on le tue et on rebind ;
#                     s'il est deja root, on ne touche a rien (pas de churn watchdog).
#  - lance non-root : on ne deplace JAMAIS un listener existant (backup only).
start_httpd(){
  P=$(listener_pid)
  if [ -n "$P" ]; then
    if am_root; then
      U=$(proc_uid "$P")
      [ "$U" = "0" ] && return 0        # deja servi en root -> ne rien faire
      kill "$P" 2>/dev/null; sleep 1     # httpd non-root (system) -> on l'evince
      P2=$(listener_pid); [ -n "$P2" ] && { kill -9 "$P2" 2>/dev/null; sleep 1; }
    else
      return 0                           # non-root : jamais deplacer (root gagne)
    fi
  fi
  chmod -R 755 "$DIR/www/cgi-bin" 2>/dev/null
  busybox httpd -p "$PORT" -h "$DIR/www"
}

# --- provisioning /system : stash + script de restauration + hook init.bigfish ---
# Rend l'anti-purge AUTO-SUFFISANT : meme une box montee via panel_guard (qui ne
# pose que /data/plugin/panel) obtient au 1er boot le declencheur de restauration.
# Idempotent : ne remonte /system rw que s'il y a reellement qqch a (re)poser.
STASH=/system/reserved/panel_stash
IBF=/system/etc/init.bigfish.sh
# contenu EMBARQUE du script de restauration -> ecrit directement dans le stash,
# INDEPENDANT du vecteur de livraison (marche meme si force_update met a jour
# la box sans que le bundle garde n'ait depose le fichier dans /data/plugin/panel).
write_restore_script(){
  cat > "$1" <<'RB'
#!/system/bin/sh
export PATH=/system/bin:/system/xbin:/vendor/bin:/sbin:$PATH
STASH=/system/reserved/panel_stash/panel.tgz
if [ ! -d /data/plugin/panel/www/cgi-bin ]; then
  [ -f "$STASH" ] || exit 0
  busybox tar xzf "$STASH" -C /data/plugin/ 2>/dev/null
fi
[ -x /data/plugin/panel/start.sh ] && /system/bin/sh /data/plugin/panel/start.sh &
RB
}
provision_system(){
  am_root || return 0
  CUR_VER=$(cat "$DIR/www/VERSION" 2>/dev/null)
  STH_VER=$(busybox tar xzf "$STASH/panel.tgz" -O panel/www/VERSION 2>/dev/null)
  NEED_STASH=0; [ -n "$CUR_VER" ] && [ "$CUR_VER" != "$STH_VER" ] && NEED_STASH=1
  NEED_RB=0; [ ! -f "$STASH/panel_restore_boot.sh" ] && NEED_RB=1
  NEED_HOOK=0; { [ -f "$IBF" ] && ! busybox grep -q panel_restore_boot "$IBF" 2>/dev/null; } && NEED_HOOK=1
  [ "$NEED_STASH" = 0 ] && [ "$NEED_RB" = 0 ] && [ "$NEED_HOOK" = 0 ] && return 0
  mount -o rw,remount /system 2>/dev/null || return 0
  mkdir -p "$STASH" 2>/dev/null
  if [ "$NEED_STASH" = 1 ]; then
    busybox tar czf "$STASH/panel.tgz.tmp" -C /data/plugin panel 2>/dev/null \
      && mv -f "$STASH/panel.tgz.tmp" "$STASH/panel.tgz"
  fi
  # script de restauration : ecrit depuis le contenu EMBARQUE, atomique
  if write_restore_script "$STASH/.rb.tmp" 2>/dev/null; then
    chmod 755 "$STASH/.rb.tmp" 2>/dev/null && mv -f "$STASH/.rb.tmp" "$STASH/panel_restore_boot.sh"
  fi
  # hook boot (idempotent) : init.bigfish.sh appelle le script de restauration
  if [ "$NEED_HOOK" = 1 ]; then
    [ -f "$IBF.bak_panel" ] || cp -f "$IBF" "$IBF.bak_panel" 2>/dev/null
    printf '\n# --- Panel stash auto-restore (survie Delete All Plugins) ---\n[ -x %s/panel_restore_boot.sh ] && /system/bin/sh %s/panel_restore_boot.sh &\n' "$STASH" "$STASH" >> "$IBF"
  fi
  mount -o ro,remount /system 2>/dev/null
}

# --- re-active swpanel (app systeme) si desactivee depuis les Parametres Android ---
# pm EXIGE ANDROID_DATA/ANDROID_ROOT (sinon "Aborted"). Attend que le framework
# soit pret (borne 300s) ; sur un tick la 1ere verif passe direct. Detache.
SWPKG=cc.mktech.swpanel
heal_swpanel(){
  am_root || return 0
  ( export ANDROID_DATA=/data ANDROID_ROOT=/system
    export PATH=/system/bin:/system/xbin:/vendor/bin:/sbin:$PATH
    i=0; while [ $i -lt 60 ]; do pm path android >/dev/null 2>&1 && break; sleep 5; i=$((i+1)); done
    pm path android >/dev/null 2>&1 || exit 0
    pm list packages "$SWPKG" 2>/dev/null | busybox grep -q "$SWPKG" || exit 0
    if pm list packages -d "$SWPKG" 2>/dev/null | busybox grep -q "$SWPKG"; then
      pm enable "$SWPKG" >/dev/null 2>&1
    fi
  ) >/dev/null 2>&1 &
}

# --- watchdog (mode par défaut uniquement) ---
if [ "$1" = "--tick" ]; then
  heal_autorun; start_httpd; provision_system; heal_swpanel; exit 0
fi

heal_autorun
start_httpd
echo "PANEL httpd sur $PORT"

# --- stash + provisioning /system + ré-activation swpanel ---
provision_system
heal_swpanel

# --- auto-update silencieux (une seule fois au boot, pas sur les ticks) ---
FU=$DIR/force_update.sh
FULOCK=/tmp/.force_update_running
if am_root && [ -x "$FU" ] && [ ! -f "$FULOCK" ]; then
  : > "$FULOCK"
  ( sleep 30; /system/bin/sh "$FU"; provision_system
    # replay : reinstalle les plugins manquants apres un restore/reset usine
    [ -f "$DIR/.restore_replay" ] && [ -x "$DIR/replay.sh" ] && \
      /system/bin/sh "$DIR/replay.sh"
    rm -f "$FULOCK" ) >/dev/null 2>&1 &
fi

# lance le watchdog s'il n'est pas déjà actif (verrou pid)
WD=$DIR/.watchdog.pid
if [ -f "$WD" ] && kill -0 "$(cat "$WD" 2>/dev/null)" 2>/dev/null; then
  : # watchdog déjà en cours
else
  if command -v setsid >/dev/null 2>&1; then
    setsid /system/bin/sh -c 'while :; do sleep 300; /system/bin/sh /data/plugin/panel/start.sh --tick; done' >/dev/null 2>&1 &
  else
    ( while :; do sleep 300; /system/bin/sh /data/plugin/panel/start.sh --tick; done ) >/dev/null 2>&1 &
  fi
  echo $! > "$WD"
fi

